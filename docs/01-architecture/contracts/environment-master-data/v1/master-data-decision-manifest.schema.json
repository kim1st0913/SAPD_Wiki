{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapd.local/contracts/environment-master-data/v1/master-data-decision-manifest.schema.json",
  "title": "SAPD Environment Master Data Decision Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "source_baseline",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "environment-master-data-decision-manifest-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_sha256",
        "environment_workbench_sha256"
      ],
      "properties": {
        "database_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_workbench_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionEntry"
      }
    }
  },
  "$defs": {
    "decisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_type",
        "stable_ref",
        "public_id",
        "code",
        "canonical_title",
        "aliases",
        "definition",
        "status",
        "decision",
        "decision_note",
        "context_evidence_refs"
      ],
      "properties": {
        "master_type": {
          "enum": [
            "information_environment",
            "environment_segment_type",
            "information_object"
          ]
        },
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(IE|ES|IO)-[0-9]{3}$"
        },
        "canonical_title": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "active",
            "deprecated",
            "merged"
          ]
        },
        "decision": {
          "enum": [
            "reuse",
            "create",
            "merge_review",
            "split_review",
            "hold"
          ]
        },
        "decision_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
