            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "enum": [
                  "create_managed_identity",
                  "install_current_user_trust",
                  "replace_current_user_trust"
                ]
              }
            },
            "action": {
              "enum": [
                "certificate_provision",
                "certificate_rotate",
                "certificate_repair_trust"
              ]
            },
            "profile": {
              "enum": [
                "dev",
                "app"
              ]
            },
            "expected_ca_fingerprint_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
            },
            "web_confirmation_required": {
              "const": true
            }
          }
        }
      }
