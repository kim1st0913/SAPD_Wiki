    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "reason_code",
        "managed_by_app",
        "profile",
        "install_id_suffix",
        "generation_id",
        "subject",
        "san",
        "ca_display_name",
        "ca_fingerprint_sha256",
        "server_fingerprint_sha256",
        "valid_from",
        "valid_until",
        "remaining_days",
        "trust_scope",
        "trust_backend",
        "secret_backend",
        "trust_policy",
        "trust_verified_at",
        "last_rotated_at",
        "operation",
        "cleanup_pending",
        "client_restart_required",
        "old_generation_retained_until",
        "next_action"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "state": {
          "enum": [
            "not_configured",
            "valid",
            "expiring",
            "renewal_required",
            "expired",
            "trust_missing",
            "trust_conflict",
            "key_unavailable",
            "clock_invalid",
            "rotating",
            "recovery_required",
            "error"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        },
        "managed_by_app": {
          "type": "boolean"
        },
        "profile": {
          "enum": [
            "dev",
            "app"
          ]
        },
        "install_id_suffix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "generation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "subject": {
          "const": "127.0.0.1"
        },
        "san": {
          "const": [
            "127.0.0.1"
          ]
        },
        "ca_display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "ca_fingerprint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
        },
        "server_fingerprint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "remaining_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4096
        },
        "trust_scope": {
          "const": "current_user"
        },
        "trust_backend": {
          "enum": [
            "fake_current_user_trust",
            "macos_user_trust",
            "windows_current_user_root"
          ]
        },
        "secret_backend": {
          "enum": [
            "in_memory_test_only",
            "macos_web_dev_keychain",
            "macos_data_protection_keychain",
            "windows_dpapi_current_user"
          ]
        },
        "trust_policy": {
          "const": "ssl_loopback_only"
        },
        "trust_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "last_rotated_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "operation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "operation_id",
            "state",
            "phase"
          ],
          "properties": {
            "operation_id": {
              "type": "string"
            },
            "state": {
              "enum": [
                "planned",
                "running",
                "completed",
                "failed"
              ]
            },
            "phase": {
              "enum": [
                "planned",
                "staged",
                "new_trust_installed",
                "switched",
                "validated",
                "retiring",
                "completed"
              ]
            }
          }
        },
        "cleanup_pending": {
          "type": "boolean"
        },
        "client_restart_required": {
          "type": "boolean"
        },
        "old_generation_retained_until": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "certificate_provision",
            "certificate_rotate",
            "certificate_repair_trust",
            "certificate_view_details",
            "certificate_reset",
            null
          ]
        }
      }
    },
