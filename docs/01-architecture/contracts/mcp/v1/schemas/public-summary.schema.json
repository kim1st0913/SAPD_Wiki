{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture://schemas/mcp-public-summary-v1",
  "title": "D0 public summary candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_schema_version",
    "d0_status",
    "policy_candidate_digest",
    "proposed_public_summary_types",
    "pilot_candidates"
  ],
  "properties": {
    "summary_schema_version": { "const": "1.0.0" },
    "d0_status": { "enum": ["NOT_READY", "STALE", "PASS", "BLOCKED"] },
    "policy_candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposed_public_summary_types": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "pilot_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposed_public_summary_types": { "maxItems": 0 }
        },
        "required": ["proposed_public_summary_types"]
      },
      "then": {
        "properties": {
          "d0_status": { "const": "NOT_READY" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "d0_status": { "const": "PASS" }
        },
        "required": ["d0_status"]
      },
      "then": {
        "properties": {
          "proposed_public_summary_types": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_ref",
        "object_type",
        "locale",
        "ai_summary",
        "summary_version",
        "summary_hash",
        "review_status",
        "reviewed_by_role",
        "reviewed_by_principal",
        "reviewed_at",
        "source_and_license_basis",
        "source_basis_digest",
        "base_manifest_digest",
        "effective_sensitive_level",
        "ai_use_policy",
        "policy_version",
        "release_status"
      ],
      "properties": {
        "canonical_ref": { "type": "string", "pattern": "^fixture://[a-z0-9./_-]+$" },
        "object_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
        "ai_summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "summary_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "summary_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "review_status": { "enum": ["approved", "rejected", "pending"] },
        "reviewed_by_role": { "type": "string", "minLength": 1 },
        "reviewed_by_principal": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "source_and_license_basis": { "type": "string", "minLength": 1 },
        "source_basis_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "base_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "effective_sensitive_level": { "const": "public" },
        "ai_use_policy": { "const": "public_summary" },
        "policy_version": { "const": "MCP-DATA-POLICY-v1" },
        "release_status": { "enum": ["candidate", "released", "revoked"] },
        "valid_until": { "type": "string", "format": "date-time" }
      }
    }
  }
}
